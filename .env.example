# Names only — never commit values. Copy to .env (git-ignored).

# --- Loader (role A) ---
ORACLE_DATA_DIR=            # where raw/ and work/ live, outside the sealed folder (default ~/exam-oracle-data)
HOTDATA_LEDGER_CATALOG=     # hotdata SQL catalog of the permanent ledger (default exam_oracle_ledger)
SEALED_DIR=                 # outside the repo; the loader refuses to run if ORACLE_DATA_DIR overlaps it

# --- LLM ---
LLM_API_KEY=
LLM_EXTRACTION_MODEL=
EMBEDDING_API_KEY=

# --- Cognee ---
COGNEE_BASE_URL=            # Cognee Cloud URL or tunnel URL
COGNEE_API_TOKEN=           # name per Cognee docs [TEST]
PERSONALIZATION_ENABLED=true

# --- HydraDB (hosted) ---
HYDRADB_API_KEY=
HYDRADB_DATABASE=exam-oracle

# --- HydraDB (open source, optional) ---
HYDRADB_OSS_BOLT_URL=bolt://127.0.0.1:7687
HYDRADB_OSS_TOKEN_FILE=

# --- hotdata (the CLI uses its own login session; these are for SDK use) [TEST] ---
HOTDATA_API_TOKEN=
HOTDATA_WORKSPACE_ID=
HOTDATA_URL=

# --- RocketRide ---
ROCKETRIDE_APIKEY=
ROCKETRIDE_URL=
ROCKETRIDE_WEBHOOK_URL=         # course-loaded webhook (pipeline P6), https
ROCKETRIDE_WEBHOOK_KEY=
ROCKETRIDE_WEBHOOK_AUTH_HEADER= # default Authorization (sent as "Bearer <key>") [TEST]

# --- Rote (credentials go through `rote token set NAME --stdin`, not here) ---
ROTE_API_KEY=

# --- Tunnel (Plan B only) ---
TUNNEL_BEARER_TOKEN=

# --- Snyk ---
SNYK_TOKEN=
