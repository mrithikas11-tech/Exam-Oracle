# Exam Oracle — environment variables (names only; never commit values)
# Every name below is either read by oracle/config.py or read by the installed SDK
# (verified from source 2026-09-11). Copy to .env and fill in.

# --- Mode switches (oracle/config.py) ---
ORACLE_BACKEND=local            # local (DuckDB, offline) | hotdata
LESSONS_STORE=local             # local (JSON) | hydradb
STUDENT_STORE=local             # local (JSON) | hydradb
ORACLE_LOCAL_DIR=               # optional; default <repo>/.local-backend (git-ignored)
ORACLE_REPO_ROOT=               # optional; set it when the package runs from outside the repo (Rote Plays from /tmp)
SEALED_DIR=                     # REQUIRED for real runs; must be OUTSIDE the repo

# --- hotdata (hotdata-framework 0.14.0 reads these three) ---
HOTDATA_API_KEY=
HOTDATA_WORKSPACE=
HOTDATA_API_URL=                # optional; SDK default host if empty
HOTDATA_LEDGER_DB=ledger        # oracle/config.py: name of the permanent ledger database

# --- HydraDB hosted (hydradb-sdk 2.1.4, import hydra_db) ---
HYDRADB_API_KEY=
HYDRADB_BASE_URL=               # optional; SDK default host if empty (oracle/lessons_store.py, oracle/students.py)
HYDRADB_DATABASE=exam-oracle

# --- Cognee 1.5.4 (oracle/refit_lessons.py's optional statement rewording reads the same LLM_* names) ---
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_ENDPOINT=                   # optional; needed by the rewording hook when LLM_PROVIDER is not openai
EMBEDDING_API_KEY=              # optional; Cognee reuses LLM_API_KEY if empty
EMBEDDING_PROVIDER=             # set by `exam-oracle llm`: openai | fastembed (local, free) | ollama | ...
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
# Choose your own LLM (Claude, ChatGPT, Gemini, a local model): `exam-oracle llm --provider claude`
PERSONALIZATION_ENABLED=true
DATA_ROOT_DIRECTORY=            # set by oracle/config.py under ORACLE_LOCAL_DIR if empty
SYSTEM_ROOT_DIRECTORY=          # (Cognee's default is INSIDE the installed package)
COGNEE_LOGS_DIR=                # set by oracle/config.py under ORACLE_LOCAL_DIR if empty (Cognee's default: ~/.cognee/logs)

# --- RocketRide (Person C) — docs use both names; check your workspace .env ---
ROCKETRIDE_APIKEY=

# --- Rote: no environment variable is documented. Use `rote login` and
#     `rote token set NAME --stdin` for credentials a Play needs.

# --- Loader (role A: the exam-oracle CLI) ---
ORACLE_DATA_DIR=                # raw/ and work/ folders; outside the sealed folder (default ~/exam-oracle-data)

# --- RocketRide course-loaded webhook (pipeline P6, called by the loader's notify step) ---
ROCKETRIDE_URL=
ROCKETRIDE_WEBHOOK_URL=         # https
ROCKETRIDE_WEBHOOK_KEY=
ROCKETRIDE_WEBHOOK_AUTH_HEADER= # default Authorization (sent as "Bearer <key>") [TEST]

# --- Tunnel (Plan B only) ---
TUNNEL_BEARER_TOKEN=

# --- Snyk ---
SNYK_TOKEN=
